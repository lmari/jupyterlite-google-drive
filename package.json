{
  "name": "jupyterlite-google-drive",
  "version": "0.2.0-alpha.1",
  "description": "Browser-only notebook access and explicit cloud saves for JupyterLite",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "jupyter-builder build .",
    "check": "node --check src/index.js && node --check src/auth.js && node --check src/drive-api.js"
  },
  "dependencies": {
    "@jupyterlab/apputils": "~4.6.0",
    "@jupyterlab/coreutils": ">=6.5.0 <7",
    "@jupyterlab/docmanager": "~4.6.0",
    "@jupyterlab/mainmenu": "~4.6.0",
    "@jupyterlab/notebook": "~4.6.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0",
    "@jupyterlab/core-meta": "~4.6.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  },
  "engines": {
    "node": ">=22"
  }
}
